#!/usr/bin/env node

/**
 * ACE CLI — Agent-powered Code Engine
 *
 * Usage:
 *   ace start                  — 대화형 세팅 가이드
 *   ace init [--pack dev|biz|all] [--stack nextjs-fastapi-pg|...] [--mode solo|team]
 *
 * 프로젝트 디렉토리에서 실행하면:
 * 1. .ace/profile.yaml 생성
 * 2. .claude/ 디렉토리에 스킬/에이전트/훅/규칙 심볼릭 링크 또는 복사
 * 3. workspace/current, workspace/tasks/ 디렉토리 생성
 */

const fs = require('fs')
const os = require('os')
const path = require('path')
const readline = require('readline')

const ACE_ROOT = path.resolve(__dirname)
const CWD = process.cwd()
const KNOWN_PACKS = ['dev', 'biz']

// ─────────────────────────────────────────────
// CLI 파싱
// ─────────────────────────────────────────────

const args = process.argv.slice(2)
const command = args[0]

function getArg(name, defaultValue) {
  const idx = args.indexOf(`--${name}`)
  if (idx === -1 || idx + 1 >= args.length) return defaultValue
  return args[idx + 1]
}

function hasFlag(name) {
  return args.includes(`--${name}`)
}

// ─────────────────────────────────────────────
// init 명령
// ─────────────────────────────────────────────

function init() {
  const pack = getArg('pack', 'dev')
  const stack = getArg('stack', 'nextjs-fastapi-pg')
  const mode = getArg('mode', 'solo')
  const projectName = path.basename(CWD)
  const packs = normalizePacks(pack)

  console.log(`\n🔧 ACE init — ${projectName}`)
  console.log(`   packs: ${packs.join(', ')}, stack: ${stack}, mode: ${mode}\n`)

  // 1. .ace/ 디렉토리 생성
  const aceDir = path.join(CWD, '.ace')
  mkdirSafe(aceDir)

  // 2. profile.yaml 생성
  const profilePath = path.join(aceDir, 'profile.yaml')
  if (fs.existsSync(profilePath)) {
    console.log('   ⚠ profile.yaml already exists, skipping')
  } else {
    const profile = generateProfile(projectName, packs, stack, mode)
    fs.writeFileSync(profilePath, profile, 'utf-8')
    console.log('   ✓ .ace/profile.yaml created')
  }

  // 3. workspace/ 구조 생성
  mkdirSafe(path.join(CWD, 'workspace'))
  mkdirSafe(path.join(CWD, 'workspace', 'current'))
  mkdirSafe(path.join(CWD, 'workspace', 'tasks'))
  const taskIndexPath = path.join(CWD, 'workspace', 'tasks', 'taskIndex.json')
  if (!fs.existsSync(taskIndexPath)) {
    fs.writeFileSync(taskIndexPath, JSON.stringify({ tasks: [] }, null, 2), 'utf-8')
  }
  console.log('   ✓ workspace/current, workspace/tasks created')

  // 4. .claude/ 설정 생성
  setupClaude(packs, stack, mode)

  // 5. .gitignore 갱신
  updateGitignore()

  console.log(`\n✅ ACE initialized for ${projectName}`)
  console.log(`   Run: ace doctor to verify the harness\n`)
}

// ─────────────────────────────────────────────
// profile.yaml 생성
// ─────────────────────────────────────────────

function generateProfile(name, pack, stack, mode) {
  const packs = normalizePacks(pack)
  const primaryPack = packs[0]
  const stackParts = parseStack(stack)
  const lines = [
    `# ACE Project Profile`,
    `# Generated by: ace init`,
    ``,
    `name: ${name}`,
    `mode: ${mode}`,
    `pack: ${primaryPack}  # backward-compatible primary pack`,
    `packs:`,
    ...packs.map((p) => `  - ${p}`),
    `targets:`,
    `  claude: true`,
    `  codex: true`,
    `workspace:`,
    `  current: workspace/current`,
    `  tasks: workspace/tasks`,
    ``,
  ]

  if (packs.includes('dev')) {
    lines.push(`stack:`)
    if (stackParts.backend) lines.push(`  backend: ${stackParts.backend}`)
    if (stackParts.frontend) lines.push(`  frontend: ${stackParts.frontend}`)
    if (stackParts.db) lines.push(`  db: ${stackParts.db}`)
    lines.push(``)
  }

  if (mode === 'team') {
    lines.push(`roles:`)
    lines.push(`  - DEV`)
    if (packs.includes('dev')) lines.push(`  - PUBL`)
    lines.push(`  - PLAN`)
    lines.push(``)
  }

  lines.push(`issue_tracker:`)
  lines.push(`  type: none  # github | linear | jira | redmine | none`)
  lines.push(`  # url: https://...`)
  lines.push(`  # api_key_env: TRACKER_API_KEY`)
  lines.push(``)

  lines.push(`# domain:`)
  lines.push(`#   terms: ./domain/terms.md`)
  lines.push(`#   docs: ./docs/`)

  return lines.join('\n') + '\n'
}

function parseStack(stack) {
  const presets = {
    'nextjs-fastapi-pg': { backend: 'fastapi', frontend: 'nextjs', db: 'postgresql' },
    'spring-vue-mssql': { backend: 'spring-boot', frontend: 'vue', db: 'mssql' },
    'react-native-expo': { frontend: 'react-native', db: 'postgresql' },
    'django-react-pg': { backend: 'django', frontend: 'react', db: 'postgresql' },
  }
  return presets[stack] || { backend: stack, frontend: 'nextjs', db: 'postgresql' }
}

// ─────────────────────────────────────────────
// .claude/ 설정 생성
// ─────────────────────────────────────────────

function setupClaude(pack, stack, mode) {
  const packs = normalizePacks(pack)
  const claudeDir = path.join(CWD, '.claude')
  mkdirSafe(claudeDir)

  // settings.json — 훅 등록
  const settingsPath = path.join(claudeDir, 'settings.json')
  if (!fs.existsSync(settingsPath)) {
    const settings = generateSettings(mode)
    fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2), 'utf-8')
    console.log('   ✓ .claude/settings.json created (hooks registered)')
  }

  // skills/ — 코어 스킬 + 팩 스킬 복사
  const skillsDir = path.join(claudeDir, 'skills')
  mkdirSafe(skillsDir)

  // core skills (ace-status 등)
  const coreSkillsDir = path.join(ACE_ROOT, 'core', 'skills')
  if (fs.existsSync(coreSkillsDir)) {
    const coreSkills = fs.readdirSync(coreSkillsDir, { withFileTypes: true })
      .filter(d => d.isDirectory())
    for (const skill of coreSkills) {
      const skillName = `ace-${skill.name}`
      const targetDir = path.join(skillsDir, skillName)
      mkdirSafe(targetDir)
      copyDirContents(path.join(coreSkillsDir, skill.name), targetDir)
    }
  }

  // pack skills
  let installedSkillCount = 0
  for (const singlePack of packs) {
    const packSkillsDir = path.join(ACE_ROOT, 'packs', singlePack, 'skills')
    if (fs.existsSync(packSkillsDir)) {
      const skills = fs.readdirSync(packSkillsDir, { withFileTypes: true })
        .filter(d => d.isDirectory())
      for (const skill of skills) {
        const skillName = `ace-${skill.name}`
        const targetDir = path.join(skillsDir, skillName)
        mkdirSafe(targetDir)
        copyDirContents(path.join(packSkillsDir, skill.name), targetDir)
        installedSkillCount++
      }
    }
  }
  console.log(`   ✓ .claude/skills/ — ${installedSkillCount} pack skills installed (ace-*)`)

  // agents/ — 에이전트 복사
  const agentsDir = path.join(claudeDir, 'agents')
  mkdirSafe(agentsDir)

  let installedAgentCount = 0
  for (const singlePack of packs) {
    const packAgentsDir = path.join(ACE_ROOT, 'packs', singlePack, 'agents')
    if (fs.existsSync(packAgentsDir)) {
      const agents = fs.readdirSync(packAgentsDir).filter(f => f.endsWith('.md'))
      for (const agent of agents) {
        fs.copyFileSync(
          path.join(packAgentsDir, agent),
          path.join(agentsDir, agent)
        )
        installedAgentCount++
      }
    }
  }
  console.log(`   ✓ .claude/agents/ — ${installedAgentCount} agents installed`)

  // rules/ — 코어 컨벤션 + 스택 컨벤션 복사
  const rulesDir = path.join(claudeDir, 'rules')
  mkdirSafe(rulesDir)

  // core 공통 컨벤션
  const coreConvs = ['conv-common.md', 'conv-security.md', 'conv-behavior.md']
  for (const conv of coreConvs) {
    const src = path.join(ACE_ROOT, 'core', conv)
    if (fs.existsSync(src)) {
      fs.copyFileSync(src, path.join(rulesDir, conv))
    }
  }

  // 스택별 컨벤션
  if (packs.includes('dev')) {
    const stackDir = path.join(ACE_ROOT, 'stacks', stack)
    if (fs.existsSync(stackDir)) {
      const stackFiles = fs.readdirSync(stackDir).filter(f => f.startsWith('conv-'))
      for (const f of stackFiles) {
        fs.copyFileSync(path.join(stackDir, f), path.join(rulesDir, f))
      }
      console.log(`   ✓ .claude/rules/ — conventions installed (${stack})`)
    } else {
      console.log(`   ⚠ Stack preset '${stack}' not found, skipping conventions`)
    }
  }

  // templates/ 복사
  const aceProjectDir = path.join(CWD, '.ace')
  const templatesDir = path.join(aceProjectDir, 'templates')
  mkdirSafe(templatesDir)

  // core templates
  const coreTemplatesDir = path.join(ACE_ROOT, 'core', 'templates')
  if (fs.existsSync(coreTemplatesDir)) {
    copyDirContents(coreTemplatesDir, templatesDir)
  }

  // pack templates
  for (const singlePack of packs) {
    const packTemplatesDir = path.join(ACE_ROOT, 'packs', singlePack, 'templates')
    if (fs.existsSync(packTemplatesDir)) {
      copyDirContents(packTemplatesDir, templatesDir)
    }
  }
  console.log('   ✓ .ace/templates/ — artifact templates installed')
}

function generateSettings(mode) {
  const settings = {
    hooks: {}
  }

  // PostToolUse — 항상 활성
  // 참고: 실제 훅 스크립트는 .ace/hooks/에 위치
  // 현재는 스캐폴딩만 — 3단계에서 JS 구현

  return settings
}

// ─────────────────────────────────────────────
// .gitignore 갱신
// ─────────────────────────────────────────────

function updateGitignore() {
  const gitignorePath = path.join(CWD, '.gitignore')
  const aceEntries = [
    '',
    '# ACE (개인 분석 산출물 — 코드 레포에 포함하지 않음)',
    'workspace/',
    '.ace/',
  ]

  if (fs.existsSync(gitignorePath)) {
    const content = fs.readFileSync(gitignorePath, 'utf-8')
    if (content.includes('# ACE')) return // 이미 있음
    fs.appendFileSync(gitignorePath, aceEntries.join('\n') + '\n', 'utf-8')
  } else {
    fs.writeFileSync(gitignorePath, aceEntries.join('\n') + '\n', 'utf-8')
  }
  console.log('   ✓ .gitignore updated')
}

// ─────────────────────────────────────────────
// 유틸리티
// ─────────────────────────────────────────────

function mkdirSafe(dir) {
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true })
  }
}

function aceDir(cwd) {
  return path.join(cwd, '.ace')
}

function normalizePacks(pack) {
  const input = Array.isArray(pack) ? pack : [pack]
  const expanded = input.flatMap((p) => {
    const value = String(p || 'dev').trim()
    return value === 'all' ? KNOWN_PACKS : [value]
  })
  const packs = [...new Set(expanded)].filter((p) => KNOWN_PACKS.includes(p))
  if (packs.length === 0) {
    console.log('\nUsage: --pack dev|biz|all\n')
    process.exit(1)
  }
  return packs
}

function readProfile(cwd = CWD) {
  const profilePath = path.join(cwd, '.ace', 'profile.yaml')
  if (!fs.existsSync(profilePath)) return ''
  return fs.readFileSync(profilePath, 'utf-8')
}

function parseProfilePacks(profileContent) {
  const packs = new Set()
  const packMatch = profileContent.match(/^pack:\s*([^\s#]+)/m)
  if (packMatch) packs.add(packMatch[1].trim())

  const packsBlock = profileContent.match(/^packs:\n((?:\s+-\s*.+\n?)+)/m)
  if (packsBlock) {
    const matches = packsBlock[1].matchAll(/^\s+-\s*([^\s#]+)/gm)
    for (const match of matches) packs.add(match[1].trim())
  }

  return [...packs].filter((p) => KNOWN_PACKS.includes(p))
}

function discoverInstalledPacks(cwd = CWD, profileContent = readProfile(cwd)) {
  const packs = new Set(parseProfilePacks(profileContent))
  const claudeSkillsDir = path.join(cwd, '.claude', 'skills')
  if (fs.existsSync(path.join(claudeSkillsDir, 'ace-analyze'))) packs.add('dev')
  if (fs.existsSync(path.join(claudeSkillsDir, 'ace-research'))) packs.add('biz')
  if (packs.size === 0) packs.add('dev')
  return normalizePacks([...packs])
}

function updateProfilePacks(profilePath, nextPacks) {
  if (!fs.existsSync(profilePath)) return
  const packs = normalizePacks(nextPacks)
  let profile = fs.readFileSync(profilePath, 'utf-8')

  if (profile.match(/^pack:\s*.+$/m)) {
    profile = profile.replace(/^pack:\s*.+$/m, `pack: ${packs[0]}  # backward-compatible primary pack`)
  } else {
    profile = profile.replace(/^mode:\s*.+$/m, `$&\npack: ${packs[0]}  # backward-compatible primary pack`)
  }

  const packsYaml = ['packs:', ...packs.map((p) => `  - ${p}`)].join('\n')
  if (profile.match(/^packs:\n(?:\s+-\s*.+\n?)+/m)) {
    profile = profile.replace(/^packs:\n(?:\s+-\s*.+\n?)+/m, packsYaml + '\n')
  } else {
    profile = profile.replace(/^pack:\s*.+$/m, `$&\n${packsYaml}`)
  }

  if (!profile.includes('targets:')) {
    profile = profile.replace(/^packs:\n(?:\s+-\s*.+\n?)+/m, `$&targets:\n  claude: true\n  codex: true\n`)
  }
  if (!profile.includes('workspace:')) {
    profile = profile.replace(/^targets:\n(?:\s+.+\n?)+/m, `$&workspace:\n  current: workspace/current\n  tasks: workspace/tasks\n`)
  }

  fs.writeFileSync(profilePath, profile, 'utf-8')
}

function resolveCodexDest(destArg) {
  if (destArg) return path.resolve(destArg)
  if (hasFlag('local')) return path.join(CWD, '.codex', 'skills')
  const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex')
  if (hasFlag('global') || fs.existsSync(codexHome)) return path.join(codexHome, 'skills')
  return path.join(CWD, '.codex', 'skills')
}

function copyDirContents(src, dest) {
  if (!fs.existsSync(src)) return
  const entries = fs.readdirSync(src, { withFileTypes: true })
  for (const entry of entries) {
    const srcPath = path.join(src, entry.name)
    const destPath = path.join(dest, entry.name)
    if (entry.isDirectory()) {
      mkdirSafe(destPath)
      copyDirContents(srcPath, destPath)
    } else {
      fs.copyFileSync(srcPath, destPath)
    }
  }
}

function extractSkillParts(skillPath) {
  const raw = fs.readFileSync(skillPath, 'utf-8')
  const match = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/)
  const frontmatter = match ? match[1] : ''
  const body = match ? match[2] : raw
  const nameMatch = frontmatter.match(/^name:\s*(.+)$/m)
  const descriptionMatch = frontmatter.match(/^description:\s*["']?(.+?)["']?$/m)
  const name = nameMatch ? nameMatch[1].trim().replace(/^["']|["']$/g, '') : path.basename(path.dirname(skillPath))
  const description = descriptionMatch ? descriptionMatch[1].trim() : `${name} skill`
  return { name, description, body }
}

function formatSkillDisplayName(skillName) {
  return skillName
    .split('-')
    .map((part) => part.toUpperCase() === 'ACE'
      ? 'ACE'
      : part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ')
}

function clipText(text, maxLength) {
  if (text.length <= maxLength) return text
  return `${text.slice(0, maxLength - 1).trimEnd()}…`
}

function yamlQuote(value) {
  return `"${String(value).replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`
}

function createCodexSkillBundle(srcDir, destDir, skillDirName) {
  mkdirSafe(destDir)
  copyDirContents(srcDir, destDir)

  const srcSkillPath = path.join(srcDir, 'SKILL.md')
  if (!fs.existsSync(srcSkillPath)) return

  const { name, description, body } = extractSkillParts(srcSkillPath)
  const shortDescription = clipText(description, 64)
  const defaultPrompt = clipText(`Use $${name} for this task.`, 128)
  const skillMarkdown = [
    '---',
    `name: ${yamlQuote(name)}`,
    `description: ${yamlQuote(description)}`,
    'metadata:',
    `  short-description: ${yamlQuote(shortDescription)}`,
    '---',
    '',
    body.trimStart(),
  ].join('\n')

  fs.writeFileSync(path.join(destDir, 'SKILL.md'), `${skillMarkdown}\n`, 'utf-8')

  const agentsDir = path.join(destDir, 'agents')
  mkdirSafe(agentsDir)
  const openaiYaml = [
    'interface:',
    `  display_name: ${yamlQuote(formatSkillDisplayName(name))}`,
    `  short_description: ${yamlQuote(shortDescription)}`,
    `  default_prompt: ${yamlQuote(defaultPrompt)}`,
    '',
    'policy:',
    '  allow_implicit_invocation: true',
    '',
  ].join('\n')
  fs.writeFileSync(path.join(agentsDir, 'openai.yaml'), openaiYaml, 'utf-8')
}

function exportCodexSkillsFromRoot(sourceRoot, pack, destRoot) {
  const packs = Array.isArray(pack) ? pack : [pack]
  const skillsToInstall = []

  const coreSkillsDir = path.join(sourceRoot, 'core', 'skills')
  if (fs.existsSync(coreSkillsDir)) {
    const coreSkills = fs.readdirSync(coreSkillsDir, { withFileTypes: true })
      .filter((d) => d.isDirectory())
    for (const skill of coreSkills) {
      skillsToInstall.push({
        srcDir: path.join(coreSkillsDir, skill.name),
        destDir: path.join(destRoot, `ace-${skill.name}`),
      })
    }
  }

  for (const singlePack of packs) {
    const packSkillsDir = path.join(sourceRoot, 'packs', singlePack, 'skills')
    if (fs.existsSync(packSkillsDir)) {
      const packSkills = fs.readdirSync(packSkillsDir, { withFileTypes: true })
        .filter((d) => d.isDirectory())
      for (const skill of packSkills) {
        skillsToInstall.push({
          srcDir: path.join(packSkillsDir, skill.name),
          destDir: path.join(destRoot, `ace-${skill.name}`),
        })
      }
    }
  }

  mkdirSafe(destRoot)
  for (const skill of skillsToInstall) {
    createCodexSkillBundle(skill.srcDir, skill.destDir)
  }

  return skillsToInstall.length
}

function exportCodexSkills() {
  let pack = getArg('pack', null)
  const destArg = getArg('dest', null)

  const profilePath = path.join(CWD, '.ace', 'profile.yaml')
  if (!pack && fs.existsSync(profilePath)) {
    const installedPacks = discoverInstalledPacks(CWD, fs.readFileSync(profilePath, 'utf-8'))
    pack = installedPacks.length > 1 ? 'all' : installedPacks[0]
  }
  if (!pack) pack = 'all'

  if (!['dev', 'biz', 'all'].includes(pack)) {
    console.log('\nUsage: ace export-codex [--pack dev|biz|all] [--global|--local|--dest <path>]\n')
    console.log('Codex 앱/CLI에서 읽을 수 있는 skill bundle을 생성합니다.')
    process.exit(1)
  }

  const destRoot = resolveCodexDest(destArg)
  const packs = pack === 'all' ? ['dev', 'biz'] : [pack]
  const installedCount = exportCodexSkillsFromRoot(ACE_ROOT, packs, destRoot)

  console.log(`\n🧠 ACE export-codex`)
  console.log(`   pack: ${packs.join(', ')}`)
  console.log(`   destination: ${destRoot}`)
  console.log(`   ✓ ${installedCount} Codex skill bundles generated`)
  if (!destArg) {
    console.log('   ℹ 기본 경로는 ~/.codex가 있으면 전역 ~/.codex/skills, 없으면 프로젝트 로컬 .codex/skills 입니다')
    console.log('   ℹ 명시하려면 --global, --local, --dest <path>를 사용하세요')
  }
  console.log('')
}

// ─────────────────────────────────────────────
// add-pack 명령 — 기존 설치에 팩 추가
// ─────────────────────────────────────────────

function addPack() {
  const pack = args[1]
  if (!pack || !['dev', 'biz'].includes(pack)) {
    console.log('\nUsage: ace add-pack <dev|biz> [--stack nextjs-fastapi-pg] [--scaffold]\n')
    console.log('기존 스킬을 유지하면서 추가 팩의 스킬/에이전트를 설치합니다.')
    console.log('--scaffold: dev 팩 추가 시 프로젝트 보일러플레이트 생성')
    process.exit(1)
  }

  const stack = getArg('stack', 'nextjs-fastapi-pg')
  const scaffold = args.includes('--scaffold')
  const projectName = path.basename(CWD)

  console.log(`\n📦 ACE add-pack — ${projectName} + ${pack}\n`)

  const claudeDir = path.join(CWD, '.claude')
  if (!fs.existsSync(claudeDir)) {
    mkdirSafe(claudeDir)
    console.log('   ℹ .claude/ 디렉토리가 없어 새로 생성합니다')
  }
  mkdirSafe(path.join(CWD, 'workspace', 'current'))
  mkdirSafe(path.join(CWD, 'workspace', 'tasks'))

  // skills 추가
  const skillsDir = path.join(claudeDir, 'skills')
  const packSkillsDir = path.join(ACE_ROOT, 'packs', pack, 'skills')
  if (fs.existsSync(packSkillsDir)) {
    const skills = fs.readdirSync(packSkillsDir, { withFileTypes: true })
      .filter(d => d.isDirectory())
    for (const skill of skills) {
      const skillName = `ace-${skill.name}`
      const targetDir = path.join(skillsDir, skillName)
      mkdirSafe(targetDir)
      copyDirContents(path.join(packSkillsDir, skill.name), targetDir)
    }
    console.log(`   ✓ skills/ — ${skills.length} skills added (ace-*)`)
  }

  // agents 추가
  const agentsDir = path.join(claudeDir, 'agents')
  mkdirSafe(agentsDir)
  const packAgentsDir = path.join(ACE_ROOT, 'packs', pack, 'agents')
  if (fs.existsSync(packAgentsDir)) {
    const agents = fs.readdirSync(packAgentsDir).filter(f => f.endsWith('.md'))
    for (const agent of agents) {
      fs.copyFileSync(
        path.join(packAgentsDir, agent),
        path.join(agentsDir, agent)
      )
    }
    console.log(`   ✓ agents/ — ${agents.length} agents added`)
  }

  // rules 추가 (dev 팩 + 스택 컨벤션)
  if (pack === 'dev') {
    const rulesDir = path.join(claudeDir, 'rules')
    mkdirSafe(rulesDir)
    const stackDir = path.join(ACE_ROOT, 'stacks', stack)
    if (fs.existsSync(stackDir)) {
      const stackFiles = fs.readdirSync(stackDir).filter(f => f.startsWith('conv-'))
      for (const f of stackFiles) {
        fs.copyFileSync(path.join(stackDir, f), path.join(rulesDir, f))
      }
      console.log(`   ✓ rules/ — conventions added (${stack})`)
    }
  }

  // templates 추가
  const templatesDir = path.join(CWD, '.ace', 'templates')
  mkdirSafe(templatesDir)
  const packTemplatesDir = path.join(ACE_ROOT, 'packs', pack, 'templates')
  if (fs.existsSync(packTemplatesDir)) {
    copyDirContents(packTemplatesDir, templatesDir)
    console.log('   ✓ templates/ — artifact templates added')
  }

  // profile.yaml pack 목록 갱신
  const profilePath = path.join(CWD, '.ace', 'profile.yaml')
  if (fs.existsSync(profilePath)) {
    const installedPacks = discoverInstalledPacks(CWD, fs.readFileSync(profilePath, 'utf-8'))
    updateProfilePacks(profilePath, [...installedPacks, pack])
    console.log(`   ✓ profile.yaml — packs: ${normalizePacks([...installedPacks, pack]).join(', ')}`)
  }

  // scaffold (dev 팩 + --scaffold 옵션)
  if (pack === 'dev' && scaffold) {
    const scaffoldDir = path.join(ACE_ROOT, 'stacks', stack, 'scaffold')
    if (fs.existsSync(scaffoldDir)) {
      copyDirContents(scaffoldDir, CWD)
      console.log(`   ✓ scaffold/ — ${stack} 보일러플레이트 생성`)
    } else {
      console.log(`   ⚠ scaffold 템플릿 없음 (${stack}) — Claude Code에서 생성 권장`)
      console.log('     Claude Code 실행 후: "프로젝트 초기 구조를 만들어줘"')
    }

    // profile.yaml에 스택 정보 추가
    if (fs.existsSync(profilePath)) {
      let profile = fs.readFileSync(profilePath, 'utf-8')
      if (!profile.includes('stack:')) {
        const stackParts = parseStack(stack)
        const stackLines = ['\nstack:']
        if (stackParts.backend) stackLines.push(`  backend: ${stackParts.backend}`)
        if (stackParts.frontend) stackLines.push(`  frontend: ${stackParts.frontend}`)
        if (stackParts.db) stackLines.push(`  db: ${stackParts.db}`)
        profile = profile.replace(/^pack: .+$/m, `$&\n${stackLines.join('\n')}`)
        fs.writeFileSync(profilePath, profile, 'utf-8')
        console.log('   ✓ profile.yaml — stack 정보 추가')
      }
    }
  }

  const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex')
  if (fs.existsSync(codexHome)) {
    const installedPacks = discoverInstalledPacks(CWD)
    const installedCount = exportCodexSkillsFromRoot(ACE_ROOT, installedPacks, path.join(codexHome, 'skills'))
    console.log(`   ✓ Codex skills/ — ${installedCount} bundles synced globally`)
  }

  console.log(`\n✅ ${pack} pack added to ${projectName}`)
  if (pack === 'dev') {
    console.log('   Claude Code/Codex를 재시작하면 새 스킬이 보입니다.')
    console.log(`   → ace doctor 로 설치 상태를 확인하세요\n`)
  } else {
    console.log('   Claude Code/Codex를 재시작하면 새 스킬이 보입니다.\n')
  }
}

