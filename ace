    ['workspace-tasks', fs.existsSync(path.join(CWD, 'workspace', 'tasks', 'taskIndex.json')), 'workspace/tasks/taskIndex.json'],
    ['claude-skills', fs.existsSync(path.join(CWD, '.claude', 'skills')), '.claude/skills'],
